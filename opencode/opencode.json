{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "file:///Users/victor/dev/vmvarela/opencode-quota/.slim/worktrees/opencode-zen-console-cli-auth/src/index.ts",
    "@dietrichgebert/ponytail",
    "oh-my-opencode-slim@2.2.24",
    "opencode-github-copilot-auto-model"
  ],
  "default_agent": "plan",
  "small_model": "opencode/space-bunny-free",
  "share": "disabled",
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "plan": {
      "model": "opencode/mimo-v2.6-flash-free",
      "variant": "high"
    },
    "build": {
      "model": "opencode/mimo-v2.6-flash-free"
    }
  },
 "mcp": {
    "engram": {
      "type": "local",
      "command": [
        "engram",
        "mcp",
        "--tools=agent"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--caps=core,network,vision"
      ],
      "enabled": true
    }
  },
  "provider": {
    "copilot": {},
    "openai": {},
    "opencode-go": {},
    "opencode": {}
  }
}
