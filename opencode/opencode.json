{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "plan": {
      "model": "opencode/mimo-v2.6-flash-free#high"
    },
    "build": {
      "model": "opencode/mimo-v2.6-flash-free"
    }
  },
  "lsp": true,
  "plugins": [],
  "provider": {
    "copilot": {},
    "opencode": {}
  },
  "mcp": {
    "servers": {
      "browsermcp": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@browsermcp/mcp@latest"
        ]
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp/oauth"
      },
      "engram": {
        "type": "local",
        "command": ["engram", "mcp"]
      }
    }
  }

}
