{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@slkiser/opencode-quota@4.8.2",
    "@dietrichgebert/ponytail",
    "oh-my-opencode-slim@2.2.19",
    "opencode-github-copilot-auto-model"
  ],
  "default_agent": "plan",
  "small_model": "opencode/nemotron-3.5-lightning-free",
  "share": "disabled",
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "plan": {
      "model": "opencode/muse-spark-1.3-contributor-free",
      "variant": "high"
    },
    "build": {
      "model": "opencode-go/glm-5.3-flash"
    }
  },
 "mcp": {
    "engram": {
      "type": "local",
      "command": [
        "engram",
        "mcp",
        "--tools=agent"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--caps=core,network,vision"
      ],
      "enabled": true
    }
  },
  "provider": {
    "copilot": {},
    "openai": {},
    "opencode-go": {},
    "opencode": {}
  }
}
