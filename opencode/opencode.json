{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "-copilot-auto-model",
    "oh-my-opencode-slim@2.2.25"
  ],
  "default_agent": "plan",
  "share": "disabled",
  "agents": {
    "explore": {
      "disabled": true
    },
    "general": {
      "disabled": true
    },
    "plan": {
      "model": "opencode/mimo-v2.6-flash-free#high"
    },
    "build": {
      "model": "opencode/mimo-v2.6-flash-free"
    },
    "title": {
      "model": "opencode/space-bunny-free"
    }
  },
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--caps=core,network,vision"
        ]
      }
    }
  },
  "providers": {
    "copilot": {},
    "openai": {},
    "opencode-go": {},
    "opencode": {}
  }
}
